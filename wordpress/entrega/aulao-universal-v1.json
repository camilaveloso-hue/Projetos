     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<!-- aulao-universal-v1 · AULÃO UNIVERSAL em um único widget HTML (CSS e JS embutidos). Fotos e fontes vêm do plugin \"Aldeia Literária — Página de vendas\" 1.4.0. -->\n<style>\n@font-face{font-family:\"Playfair Display\";font-weight:700;font-style:normal;font-display:swap;src:url(https://aaldeialiteraria.com.br/wp-content/plugins/aldeia-vendas/assets/aulao/fonts/playfair-display-latin-700-normal.woff2) format(\"woff2\")}\n@font-face{font-family:\"Playfair Display\";font-weight:900;font-style:normal;font-display:swap;src:url(https://aaldeialiteraria.com.br/wp-content/plugins/aldeia-vendas/assets/aulao/fonts/playfair-display-latin-900-normal.woff2) format(\"woff2\")}\n@font-face{font-family:\"Playfair Display\";font-weight:900;font-style:italic;font-display:swap;src:url(https://aaldeialiteraria.com.br/wp-content/plugins/aldeia-vendas/assets/aulao/fonts/playfair-display-latin-900-italic.woff2) format(\"woff2\")}\n@font-face{font-family:\"DM Sans\";font-weight:400;font-style:normal;font-display:swap;src:url(https://aaldeialiteraria.com.br/wp-content/plugins/aldeia-vendas/assets/aulao/fonts/dm-sans-latin-400-normal.woff2) format(\"woff2\")}\n@font-face{font-family:\"DM Sans\";font-weight:500;font-style:normal;font-display:swap;src:url(https://aaldeialiteraria.com.br/wp-content/plugins/aldeia-vendas/assets/aulao/fonts/dm-sans-latin-500-normal.woff2) format(\"woff2\")}\n@font-face{font-family:\"DM Sans\";font-weight:700;font-style:normal;font-display:swap;src:url(https://aaldeialiteraria.com.br/wp-content/plugins/aldeia-vendas/assets/aulao/fonts/dm-sans-latin-700-normal.woff2) format(\"woff2\")}\n/* AULÃO MASTER — versão curta, feita para celular (Black Friday 2026)\n   Identidade: fundo creme, títulos em Playfair Display 900, texto em DM Sans, amarelo como destaque,\n   marca-texto lilás, botões pretos com texto amarelo, seções pretas. Coluna estreita e centralizada.\n   Layout: uma coluna de ~640px; cartões de benefícios em 1 coluna no celular e 2 no computador. */\n:root{\n  --cream:#fdfaec; --ink:#09090a; --yellow:#ffd60a; --yellow-soft:#fff3b0;\n  --lilac:#e8dcfb; --violet:#7c3aed; --violet2:#6d28d9; --muted:#5d5b53; --line:#ece5c8; --card:#ffffff; --green:#16a34a;\n  --f-head:\"Playfair Display\",Georgia,\"Times New Roman\",serif;\n  --f-body:\"DM Sans\",\"Helvetica Neue\",Arial,sans-serif;\n  --col:640px;\n}\nhtml{scroll-behavior:smooth;color-scheme:light}\nhtml,body{margin:0}\nbody{background:var(--cream);color:var(--ink);font-family:var(--f-body);font-size:1.0625rem;line-height:1.6;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}\nbody::before{content:\"\";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--ink);z-index:60}\n*,*::before,*::after{box-sizing:border-box}\nimg{max-width:100%;display:block}\na{color:inherit}\np{margin:0}\nh1,h2,h3{font-family:var(--f-head);font-weight:900;margin:0;line-height:1.08;letter-spacing:-.02em;text-wrap:balance;color:var(--ink)}\n.am-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}\n.am-wrap{width:100%;max-width:calc(var(--col) + 2 * max(20px,env(safe-area-inset-left,0px)));margin-inline:auto;padding-left:max(20px,env(safe-area-inset-left,0px));padding-right:max(20px,env(safe-area-inset-right,0px))}\n.am-sec{padding-block:clamp(44px,9vw,76px)}\n.am-center{text-align:center}\n.am-hl{background:linear-gradient(transparent 52%,var(--lilac) 52%,var(--lilac) 92%,transparent 92%);padding-inline:.12em;-webkit-box-decoration-break:clone;box-decoration-break:clone}\n.am-h2{font-size:clamp(1.9rem,7vw,2.7rem)}\n.am-lead{font-size:1.12rem;line-height:1.6;color:var(--muted)}\n.am-lead strong{color:var(--ink)}\n.am-pill{display:inline-flex;align-items:center;gap:9px;background:var(--ink);color:#fff;font-weight:700;font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;padding:10px 18px;border-radius:99px;line-height:1.2}\n.am-pill::before{content:\"\";width:8px;height:8px;border-radius:50%;background:var(--yellow);flex:none}\n.am-dark{background:var(--ink);color:#d9d7cc}\n.am-dark h2,.am-dark h3{color:#fff}\n\n/* promoção: faixa preta com contagem regressiva */\n.am-alert{position:sticky;top:env(safe-area-inset-top,0px);z-index:50;background:var(--ink);color:#fff;border-bottom:1px solid #2a2a2c}\n.am-alert .am-wrap{max-width:var(--col);display:flex;gap:10px 12px;align-items:center;justify-content:space-between;padding-block:9px}\n.am-alert__info{display:flex;flex-direction:column;align-items:flex-start;gap:3px;min-width:0;flex:1 1 auto}\n.am-alert .am-count{gap:4px}\n.am-alert .am-count span{font-size:.88rem;padding:2px 6px}\n.am-alert__txt{font-weight:700;font-size:.8rem;line-height:1.2}\n.am-alert__txt b{color:var(--yellow)}\n.am-count{display:inline-flex;gap:6px;font-variant-numeric:tabular-nums}\n.am-count span{display:inline-flex;align-items:baseline;gap:3px;background:rgba(255,255,255,.12);color:var(--yellow);border-radius:8px;padding:2px 8px;font-weight:700;font-size:.95rem;line-height:1.25}\n.am-count small{font-size:.66rem;font-weight:700;color:#fff;opacity:.8}\n.am-count--big{gap:8px}\n.am-count--big span{background:rgba(255,255,255,.12);color:var(--yellow);font-size:clamp(1.5rem,6vw,2rem);padding:8px 13px;border-radius:12px}\n.am-count--big small{font-size:.76rem}\n/* depois de 30/11 a página continua no ar, com o preço cheio */\n.am-regular{display:none}\n.am-is-closed .am-regular{display:revert}\n.am-is-closed .am-promo{display:none!important}\n\n/* botões */\n.am-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;background:var(--ink);color:var(--yellow);font-family:var(--f-body);font-weight:700;font-size:1.1rem;text-decoration:none;padding:17px 26px;border-radius:14px;border:0;cursor:pointer;line-height:1.2;text-align:center;box-shadow:0 8px 0 rgba(9,9,10,.14);transition:transform .15s,box-shadow .15s;width:100%}\n.am-btn:hover{transform:translateY(2px);box-shadow:0 5px 0 rgba(9,9,10,.14)}\n.am-btn--yellow{background:var(--yellow);color:var(--ink);box-shadow:0 8px 0 rgba(255,214,10,.25)}\n.am-btn--ghost{background:transparent;color:var(--ink);box-shadow:none;border:2px solid var(--ink)}\n.am-btn--ghost:hover{background:var(--ink);color:var(--yellow);transform:none}\n.am-btn--bar{width:auto;flex:none;padding:10px 13px;font-size:.8rem;letter-spacing:.02em;box-shadow:none;white-space:nowrap;border-radius:12px}\n.am-btn--bar:hover{box-shadow:none;transform:none;background:#fff}\n.am-btn--sm{width:auto;padding:11px 18px;font-size:.95rem;box-shadow:none}\na:focus-visible,button:focus-visible,summary:focus-visible,.am-track:focus-visible{outline:3px solid var(--violet);outline-offset:3px}\n.am-dark a:focus-visible{outline-color:var(--yellow)}\n\n/* relevo de montanhas no fundo de algumas seções (o desenho vem do build_aulao.py) */\n.am-mtn{position:relative;overflow:hidden;isolation:isolate}\n.am-mtn::after{content:\"\";position:absolute;left:0;right:0;bottom:0;height:clamp(120px,30vw,230px);background-repeat:no-repeat;background-position:bottom center;background-size:100% 100%;z-index:-1;pointer-events:none}\n.am-mtn--light::after{background-image:url(\"data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%201200%20260%22%20preserveAspectRatio=%22none%22%3E%3Cpath%20d=%22M-20%20190%20L79%20106%20L171%20143%20L260%20177%20L409%20105%20L501%20143%20L590%20182%20L739%20124%20L831%20154%20L920%20181%20L1069%2084%20L1161%20136%20L1250%20186%20L1240%20260%20L-20%20260%20Z%22%20fill=%22%23efe6fc%22/%3E%3Cpath%20d=%22M-20%20190%20L79%20106%20L171%20143%20L260%20177%20L409%20105%20L501%20143%20L590%20182%20L739%20124%20L831%20154%20L920%20181%20L1069%2084%20L1161%20136%20L1250%20186%22%20fill=%22none%22%20stroke=%22%239b7be0%22%20stroke-width=%221.4%22%20stroke-linejoin=%22round%22%20stroke-linecap=%22round%22%20opacity=%220.9%22/%3E%3Cpath%20d=%22M-20%20214%20L58%20145%20L131%20177%20L201%20205%20L318%20158%20L391%20183%20L461%20210%20L578%20152%20L651%20177%20L721%20213%20L838%20150%20L911%20181%20L981%20210%20L1098%20122%20L1171%20165%20L1241%20207%20L1240%20260%20L-20%20260%20Z%22%20fill=%22%23e5d8fa%22/%3E%3Cpath%20d=%22M-20%20214%20L58%20145%20L131%20177%20L201%20205%20L318%20158%20L391%20183%20L461%20210%20L578%20152%20L651%20177%20L721%20213%20L838%20150%20L911%20181%20L981%20210%20L1098%20122%20L1171%20165%20L1241%20207%22%20fill=%22none%22%20stroke=%22%239b7be0%22%20stroke-width=%221.4%22%20stroke-linejoin=%22round%22%20stroke-linecap=%22round%22%20opacity=%220.7%22/%3E%3Cpath%20d=%22M-20%20240%20L43%20188%20L102%20209%20L158%20236%20L253%20184%20L312%20207%20L368%20236%20L463%20184%20L522%20208%20L578%20233%20L673%20209%20L732%20224%20L788%20232%20L883%20183%20L942%20210%20L998%20234%20L1093%20204%20L1152%20221%20L1208%20237%20L1240%20260%20L-20%20260%20Z%22%20fill=%22%23dccbf6%22/%3E%3Cpath%20d=%22M-20%20240%20L43%20188%20L102%20209%20L158%20236%20L253%20184%20L312%20207%20L368%20236%20L463%20184%20L522%20208%20L578%20233%20L673%20209%20L732%20224%20L788%20232%20L883%20183%20L942%20210%20L998%20234%20L1093%20204%20L1152%20221%20L1208%20237%22%20fill=%22none%22%20stroke=%22%239b7be0%22%20stroke-width=%221.4%22%20stroke-linejoin=%22round%22%20stroke-linecap=%22round%22%20opacity=%220.5%22/%3E%3C/svg%3E\")}\n.am-mtn--dark::after{background-image:url(\"data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%201200%20260%22%20preserveAspectRatio=%22none%22%3E%3Cpath%20d=%22M-20%20190%20L79%20106%20L171%20143%20L260%20177%20L409%20105%20L501%20143%20L590%20182%20L739%20124%20L831%20154%20L920%20181%20L1069%2084%20L1161%20136%20L1250%20186%20L1240%20260%20L-20%20260%20Z%22%20fill=%22rgba(255,255,255,.04)%22/%3E%3Cpath%20d=%22M-20%20190%20L79%20106%20L171%20143%20L260%20177%20L409%20105%20L501%20143%20L590%20182%20L739%20124%20L831%20154%20L920%20181%20L1069%2084%20L1161%20136%20L1250%20186%22%20fill=%22none%22%20stroke=%22%23c9b2f2%22%20stroke-width=%221.4%22%20stroke-linejoin=%22round%22%20stroke-linecap=%22round%22%20opacity=%220.9%22/%3E%3Cpath%20d=%22M-20%20214%20L58%20145%20L131%20177%20L201%20205%20L318%20158%20L391%20183%20L461%20210%20L578%20152%20L651%20177%20L721%20213%20L838%20150%20L911%20181%20L981%20210%20L1098%20122%20L1171%20165%20L1241%20207%20L1240%20260%20L-20%20260%20Z%22%20fill=%22rgba(255,255,255,.06)%22/%3E%3Cpath%20d=%22M-20%20214%20L58%20145%20L131%20177%20L201%20205%20L318%20158%20L391%20183%20L461%20210%20L578%20152%20L651%20177%20L721%20213%20L838%20150%20L911%20181%20L981%20210%20L1098%20122%20L1171%20165%20L1241%20207%22%20fill=%22none%22%20stroke=%22%23c9b2f2%22%20stroke-width=%221.4%22%20stroke-linejoin=%22round%22%20stroke-linecap=%22round%22%20opacity=%220.7%22/%3E%3Cpath%20d=%22M-20%20240%20L43%20188%20L102%20209%20L158%20236%20L253%20184%20L312%20207%20L368%20236%20L463%20184%20L522%20208%20L578%20233%20L673%20209%20L732%20224%20L788%20232%20L883%20183%20L942%20210%20L998%20234%20L1093%20204%20L1152%20221%20L1208%20237%20L1240%20260%20L-20%20260%20Z%22%20fill=%22rgba(255,255,255,.09)%22/%3E%3Cpath%20d=%22M-20%20240%20L43%20188%20L102%20209%20L158%20236%20L253%20184%20L312%20207%20L368%20236%20L463%20184%20L522%20208%20L578%20233%20L673%20209%20L732%20224%20L788%20232%20L883%20183%20L942%20210%20L998%20234%20L1093%20204%20L1152%20221%20L1208%20237%22%20fill=%22none%22%20stroke=%22%23c9b2f2%22%20stroke-width=%221.4%22%20stroke-linejoin=%22round%22%20stroke-linecap=%22round%22%20opacity=%220.5%22/%3E%3C/svg%3E\")}\n.am-mtn--dark{padding-bottom:clamp(120px,30vw,230px)}\n.am-hero.am-mtn{padding-bottom:clamp(120px,28vw,210px)}\n\n/* hero */\n.am-hero{padding-block:clamp(34px,8vw,64px) clamp(40px,8vw,64px);text-align:center;background:radial-gradient(120% 70% at 50% 0%,#f6edff 0%,rgba(253,250,236,0) 65%)}\n.am-hero h1{margin-top:22px;font-size:clamp(3rem,15vw,5.6rem);font-weight:900;line-height:.95;letter-spacing:-.035em}\n.am-tag{margin-top:14px;font-family:var(--f-head);font-style:italic;font-weight:900;font-size:clamp(1.55rem,6.4vw,2.3rem);line-height:1.15;letter-spacing:-.01em}\n.am-hero .am-lead{margin:20px auto 0;max-width:30em}\n.am-author{display:inline-flex;gap:12px;align-items:center;margin-top:24px;text-align:left;background:#fff;border:1px solid var(--line);border-radius:99px;padding:8px 20px 8px 8px}\n.am-author img{width:46px;height:46px;border-radius:50%;object-fit:cover;object-position:42% 26%;flex:none}\n.am-author strong{display:block;font-size:.95rem;line-height:1.25}\n.am-author span{display:block;font-size:.8rem;color:var(--muted);line-height:1.3}\n.am-hero__cta{margin:26px auto 0;max-width:340px}\n\n/* o que é + benefícios */\n.am-what h2{margin-top:0}\n.am-what .am-lead{margin-top:16px}\n.am-benefits{list-style:none;margin:28px 0 0;padding:0;display:grid;gap:12px}\n.am-benefits li{--ic-bg:var(--violet2);--ic-fg:#fff;display:grid;grid-template-columns:44px 1fr;gap:4px 14px;align-items:start;text-align:left;background:var(--card);border:1px solid #ddd0f7;border-radius:18px;padding:16px 16px 16px 14px;box-shadow:0 2px 0 #ddd0f7}\n.am-benefits svg{grid-row:1/3;width:44px;height:44px}\n.am-benefits b{font-weight:700;font-size:1.04rem;line-height:1.25;align-self:end}\n.am-benefits li>span{font-size:.93rem;color:var(--muted);line-height:1.45}\n.am-benefits li.is-hot{background:var(--lilac);border-color:#d4bff6;box-shadow:0 2px 0 #d4bff6}\n.am-benefits li.is-hot>span{color:#3b2a63}\n\n/* partes da aula (só títulos) */\n.am-parts{list-style:none;margin:28px 0 0;padding:0;border-top:1px solid #2c2c2e;counter-reset:p}\n.am-parts li{display:grid;grid-template-columns:48px 1fr;align-items:start;gap:6px;padding:15px 0;border-bottom:1px solid #2c2c2e;font-family:var(--f-head);font-weight:700;font-size:1.2rem;color:#fff;line-height:1.25}\n.am-parts li::before{counter-increment:p;content:\"0\" counter(p);font-family:var(--f-head);font-weight:900;font-size:1.5rem;color:var(--yellow)}\n.am-parts small{display:block;font-family:var(--f-body);font-weight:400;font-size:.9rem;line-height:1.45;color:#b4b2a6;margin-top:4px}\n\n/* oferta */\n.am-offer{background:var(--card);border:2px solid var(--ink);border-radius:26px;padding:clamp(22px,6vw,34px);margin-top:26px;text-align:center;display:grid;gap:18px;box-shadow:0 10px 0 var(--ink)}\n.am-offer .am-pill{justify-self:center}\n.am-price{display:grid;justify-items:center;gap:2px}\n.am-price s{font-size:1.05rem;color:var(--muted)}\n.am-price strong{font-family:var(--f-head);font-weight:900;font-size:clamp(3.8rem,19vw,5.4rem);line-height:1;letter-spacing:-.04em}\n.am-price>span{font-size:.9rem;color:var(--muted)}\n.am-price strong span{font-size:inherit;color:inherit}\n.am-list{list-style:none;margin:0;padding:0;display:grid;gap:12px;text-align:left}\n.am-list li{display:grid;grid-template-columns:24px 1fr;gap:12px;align-items:start;font-weight:700;line-height:1.35}\n.am-list li svg{margin-top:1px;color:var(--violet2)}\n.am-list svg{width:24px;height:24px}\n.am-bonus{background:var(--yellow-soft);border:1px dashed #b89a00;border-radius:14px;padding:12px 14px;font-size:.92rem;line-height:1.45;text-align:left}\n.am-bonus b{font-weight:700}\n.am-bonus .am-count{margin-top:8px}\n.am-bonus .am-count span{background:var(--ink);color:var(--yellow);font-size:.95rem}\n.am-reveal{display:grid;justify-items:center}\n.am-reveal>summary{list-style:none;cursor:pointer;width:auto;padding:10px 20px;font-size:.95rem}\n.am-reveal>summary::-webkit-details-marker{display:none}\n.am-reveal[open]>summary{display:none}\n.am-reveal__body{display:grid;gap:18px;justify-items:stretch;width:100%;animation:amFade .35s ease both}\n.am-reveal__body .am-pill{justify-self:center}\n@keyframes amFade{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:none}}\n.am-note{font-size:.84rem;color:var(--muted);line-height:1.5}\n.am-note a{font-weight:700}\n\n/* quem sou eu */\n.am-bio{display:grid;gap:22px;justify-items:center;text-align:center}\n.am-bio__photo{width:min(230px,62%);position:relative}\n.am-bio__photo img{width:100%;height:auto;border-radius:22px;border:3px solid var(--ink);box-shadow:8px 8px 0 var(--yellow);background:var(--line)}\n.am-bio h2{font-size:clamp(1.8rem,6.4vw,2.4rem)}\n.am-bio .am-lead{margin-top:10px}\n.am-chips{list-style:none;margin:16px 0 0;padding:0;display:flex;flex-wrap:wrap;gap:8px;justify-content:center}\n.am-chips li{background:var(--lilac);color:#4c1d95;font-weight:700;font-size:.78rem;padding:7px 13px;border-radius:99px;line-height:1.2}\n\n/* carrossel */\n.am-carousel{margin-top:26px}\n.am-track{list-style:none;margin:0;padding:6px max(20px,env(safe-area-inset-left,0px)) 16px;display:flex;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;-webkit-overflow-scrolling:touch;scrollbar-width:none}\n.am-track::-webkit-scrollbar{display:none}\n.am-slide{flex:0 0 clamp(170px,46vw,240px);scroll-snap-align:center}\n.am-slide img{width:100%;height:auto;aspect-ratio:3/4;object-fit:cover;border-radius:18px;background:var(--line);border:2px solid var(--ink)}\n.am-carousel__nav{display:flex;gap:10px;justify-content:center;margin-top:6px}\n.am-arrow{width:46px;height:46px;border-radius:50%;border:2px solid var(--ink);background:#fff;color:var(--ink);font-size:1.25rem;line-height:1;cursor:pointer;font-weight:700;font-family:var(--f-body)}\n.am-arrow:hover{background:var(--ink);color:var(--yellow)}\n\n/* faq */\n.am-faq{margin-top:24px;display:grid;gap:10px}\n.am-faq details{background:var(--card);border:1px solid var(--line);border-radius:16px}\n.am-faq summary{cursor:pointer;list-style:none;padding:16px 48px 16px 18px;font-weight:700;font-size:1.02rem;position:relative;line-height:1.3}\n.am-faq summary::-webkit-details-marker{display:none}\n.am-faq summary::after{content:\"+\";position:absolute;right:18px;top:50%;transform:translateY(-50%);font-size:1.5rem;font-weight:500;line-height:1}\n.am-faq details[open] summary::after{content:\"–\"}\n.am-faq .am-ans{padding:0 18px 18px;font-size:.98rem;color:var(--muted);line-height:1.55}\n.am-faq .am-ans a{color:var(--ink);font-weight:700}\n\n/* chamada final */\n.am-final{text-align:center}\n.am-final h2{font-size:clamp(2.1rem,9vw,3.2rem)}\n.am-final .am-lead{color:#c9c7bb;margin-top:14px}\n.am-final .am-count{margin-top:22px;justify-content:center}\n.am-final .am-btn{margin-top:22px;max-width:420px}\n.am-final .am-price-line{margin-top:18px;color:#fff;font-weight:700}\n.am-final .am-price-line s{color:#a8a69b;font-weight:400}\n\n/* rodapé */\n.am-footer{background:var(--ink);color:#8f8d82;padding-block:30px;font-size:.82rem;line-height:1.7;text-align:center;border-top:1px solid #2a2a2c}\n.am-footer .am-wrap{display:grid;gap:6px}\n.am-footer a{color:#d9d7cc}\n.am-footer b{color:var(--yellow);font-family:var(--f-head);font-size:1.05rem}\n\n@media (min-width:700px){\n  .am-alert__info{flex-direction:row;align-items:center;gap:12px}\n  .am-alert__txt{font-size:.92rem}\n  .am-benefits{grid-template-columns:1fr 1fr}\n  .am-bio{grid-template-columns:230px 1fr;text-align:left;justify-items:start;align-items:center;gap:36px}\n  .am-bio__photo{width:230px}\n  .am-chips{justify-content:flex-start}\n}\n@media (prefers-reduced-motion:reduce){.am-reveal__body{animation:none}html{scroll-behavior:auto}.am-track{scroll-behavior:auto}.am-btn{transition:none}}\n\n.e-con:has(>.elementor-widget-html .am-root){--padding-top:0px;--padding-right:0px;--padding-bottom:0px;--padding-left:0px;--gap:0px;--row-gap:0px;--column-gap:0px;--margin-top:0px;--margin-bottom:0px}.am-root{background:#fdfaec;color:#09090a}.elementor-widget-html:has(.am-root){margin:0}.elementor-widget-html:has(.am-root)>.elementor-widget-container{margin:0;padding:0}</style>\n<div class=\"am-root\">\n\n<div class=\"am-alert\" role=\"status\"><div class=\"am-wrap\">\n  <div class=\"am-alert__info\">\n    <span class=\"am-alert__txt am-promo\">A promoção acaba em:</span>\n    <span class=\"am-count am-promo\" data-count=\"sale\" aria-hidden=\"true\"><span>7<small>d</small></span><span>00<small>h</sm